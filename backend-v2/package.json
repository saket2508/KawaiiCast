    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffprobe-static": "^3.1.0",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "range-parser": "^1.2.1",
    "pg": "^8.12.0",
    "webtorrent": "^1.9.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.30",
